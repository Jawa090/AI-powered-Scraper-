# RAG Database Connection (PostgreSQL + pgvector)
RAG_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataops
RAG_PORT=8001

# Authentication Token (must match Backend RAG_SERVICE_TOKEN)
RAG_SERVICE_TOKEN=rag-secret-token-change-in-production

# Embedding Model Configuration
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIM=768

# Cache & Logging
RAG_STATUS_CACHE_SECONDS=30
LOG_LEVEL=INFO
