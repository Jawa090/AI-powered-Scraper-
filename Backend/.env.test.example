# ===========================================================================
# Backend/.env.test.example â€” Test Environment Configuration Template
# All P1.2 keys with safe defaults for running the test suite.
# ===========================================================================

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataops_test
CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/dataops_test
ENVIRONMENT=test
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000

# Built-in accounts
AUTH_ADMIN_USERNAME=Admin
AUTH_ADMIN_PASSWORD=Admin
AUTH_USER_USERNAME=User123
AUTH_USER_PASSWORD=User123
JWT_SECRET=test_jwt_secret_that_is_at_least_32_chars_long_12345
JWT_EXPIRE_HOURS=8

# LLM (single provider, no fallback; empty in test unless scripted)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_THINKING_LEVEL=
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=1

# Agent
MAX_TOOL_STEPS=6
RECURSION_LIMIT=25
HISTORY_TOKEN_BUDGET=6000
SUMMARY_TRIGGER_MESSAGES=30
FRESHNESS_DAYS=30
LANGGRAPH_STRICT_MSGPACK=true

# RAG service (empty URL = not_deployed)
RAG_SERVICE_URL=
RAG_SERVICE_TOKEN=
RAG_TIMEOUT_S=5
RAG_TOP_K=5

# Scrapers / worker (fixture mode for offline tests)
NYSCR_USERNAME=
NYSCR_PASSWORD=
SELENIUM_MODE=local
SELENIUM_REMOTE_URL=
SCRAPER_MODE=fixture
WORKER_POLL_SECONDS=1
JOB_STALE_SECONDS=60
CAPTCHA_WAIT_SECONDS=60
CHECKPOINT_RETENTION_DAYS=1

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
