# ===========================================================================
# DataOps AI Platform - Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# DO NOT put real API keys in this file. This is a template only.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Connection URL (psycopg3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/dataops

# ---------------------------------------------------------------------------
# Application Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# LLM Provider Selection
#
# LLM_PRIMARY_PROVIDER   — which provider to try first (gemini | deepseek | nvidia)
# LLM_FALLBACK_PROVIDERS — comma-separated fallback order (skips unconfigured providers)
# ---------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=deepseek,nvidia

# ---------------------------------------------------------------------------
# Gemini (Google) — OpenAI-compatible endpoint
# GEMINI_API_KEY is required for Gemini to be READY.
# The legacy LLM_API_KEY / LLM_BASE_URL / LLM_MODEL vars are also supported
# for backwards compatibility with existing .env files.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# Legacy aliases (still honoured — remove once you switch to the GEMINI_* vars above)
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_TIMEOUT=30

# ---------------------------------------------------------------------------
# DeepSeek — OpenAI-compatible endpoint (OPTIONAL)
# If DEEPSEEK_API_KEY is empty, DeepSeek is skipped without crashing.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# ---------------------------------------------------------------------------
# NVIDIA NIM — OpenAI-compatible endpoint (OPTIONAL)
# If NVIDIA_API_KEY is empty, NVIDIA NIM is skipped without crashing.
# Consult https://integrate.api.nvidia.com for available model IDs.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT=30

# ---------------------------------------------------------------------------
# NYSCR (New York State Contract Reporter) Credentials
# Required for the NYSCR scraper to authenticate with the portal.
# ---------------------------------------------------------------------------
NYSCR_USERNAME=
NYSCR_PASSWORD=
