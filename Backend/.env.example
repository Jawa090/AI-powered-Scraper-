# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataops
CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/dataops
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

# Fresh-database accounts; existing DB passwords and disabled status are preserved.
AUTH_ADMIN_USERNAME=Admin
AUTH_ADMIN_PASSWORD=Admin
AUTH_USER_USERNAME=User123
AUTH_USER_PASSWORD=User
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# Provider order: DeepSeek, Gemini, OpenRouter. Set the keys for available providers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional generic provider configuration (also accepted).
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_THINKING_LEVEL=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1

# Agent
MAX_TOOL_STEPS=6
RECURSION_LIMIT=25
HISTORY_TOKEN_BUDGET=6000
SUMMARY_TRIGGER_MESSAGES=30
FRESHNESS_DAYS=30
LANGGRAPH_STRICT_MSGPACK=true

# RAG service (folder RAG/). Empty URL â†’ knowledge base reported as "not_deployed".
RAG_SERVICE_URL=
RAG_SERVICE_TOKEN=
RAG_TIMEOUT_S=10
RAG_TOP_K=5

# Scrapers / worker
NYSCR_USERNAME=
NYSCR_PASSWORD=
NYSCR_HEADLESS=false
NYSCR_DEBUGGER_ADDRESS=
NYSCR_MAX_PAGES=20
NYSCR_VIEWER_URL=
DASNY_MAX_PAGES=10
SCRAPER_HEADLESS=true
JWIZ_ENRICH_PROFILES=true
SELENIUM_MODE=local
SELENIUM_REMOTE_URL=
SCRAPER_MODE=live
WORKER_POLL_SECONDS=2
JOB_STALE_SECONDS=300
CAPTCHA_WAIT_SECONDS=300
CHECKPOINT_RETENTION_DAYS=30

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
